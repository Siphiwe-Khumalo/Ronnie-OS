# Alerta — Environment Configuration
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project settings (Project Settings > API).
#
# IMPORTANT: Only the anon/public key belongs here. Never put the
# service_role key in frontend code or in any file that ships to the
# browser. The service_role key should only ever be used server-side
# (e.g. in a Supabase Edge Function), never in this Vite app.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Your Supabase anon/public API key (safe for the browser, protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Optional: Web Push / notifications (see README "Notifications" section).
# Leave blank to disable browser push notifications — SOS + Realtime will
# still work without it.
VITE_VAPID_PUBLIC_KEY=
